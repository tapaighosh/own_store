# Own Store — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.

# ==========================================
# REQUIRED: Database & Authentication
# ==========================================

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Get this from: MongoDB Atlas -> Your Cluster -> Connect -> Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/own_store?retryWrites=true&w=majority

# NextAuth secret — generate a secure secret using:
# Terminal: openssl rand -base64 32
# This is used to encrypt and sign JWT session tokens. Keep it highly secure!
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# ==========================================
# REQUIRED: Application URLs
# ==========================================

# Full URL of your deployment (must not have a trailing slash)
# Development: http://localhost:3000
# Production:  https://yourstore.com
NEXTAUTH_URL=http://localhost:3000

# Public-facing app URL (visible to client-side code and used for SEO/Sitemap generation)
# Generally this should exactly match your NEXTAUTH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# REQUIRED: Vercel Blob Storage
# ==========================================

# Provided automatically when you connect a Vercel Blob store.
# This handles all your product image uploads.
# For local development, get this from Vercel Dashboard:
# Storage -> Your Blob Store -> .env.local tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ==========================================
# OPTIONAL / FUTURE FEATURES
# ==========================================

# Graphify analytics (future module)
# GRAPHIFY_API_KEY=
