# Own Store — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.

# ─────────────────────────────────────────
# Required — must be set before running
# ─────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Get this from: MongoDB Atlas → Your Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/own_store?retryWrites=true&w=majority

# NextAuth secret — generate with: openssl rand -base64 32
# Used to sign JWT session tokens. Keep this secret!
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Full URL of your deployment (no trailing slash)
# Development: http://localhost:3000
# Production:  https://yourstore.com
NEXTAUTH_URL=http://localhost:3000

# Public-facing app URL (visible to client-side code)
# Must match NEXTAUTH_URL in most cases
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────
# Vercel Blob (auto-provided on Vercel)
# ─────────────────────────────────────────

# Provided automatically when you connect a Vercel Blob store.
# Only needed locally for development — get from Vercel Dashboard:
# Storage → Your Blob Store → .env.local tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─────────────────────────────────────────
# Optional / Future
# ─────────────────────────────────────────

# Graphify analytics (future module)
# GRAPHIFY_API_KEY=
